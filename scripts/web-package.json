{
  "name": "@open-jsbridge/web",
  "version": "0.2.0",
  "description": "Web SDK for Open JSBridge hosts",
  "license": "MIT",
  "type": "module",
  "types": "./packages/web-sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/web-sdk/src/index.d.ts",
      "import": "./packages/web-sdk/src/index.js"
    },
    "./auto": {
      "types": "./packages/web-sdk/src/auto.d.ts",
      "import": "./packages/web-sdk/src/auto.js"
    },
    "./mock": {
      "types": "./packages/web-mock/src/index.d.ts",
      "import": "./packages/web-mock/src/index.js"
    },
    "./app": {
      "types": "./packages/web-sdk/src/app.d.ts",
      "import": "./packages/web-sdk/src/app.js"
    },
    "./device": {
      "types": "./packages/web-sdk/src/device.d.ts",
      "import": "./packages/web-sdk/src/device.js"
    },
    "./network": {
      "types": "./packages/web-sdk/src/network.d.ts",
      "import": "./packages/web-sdk/src/network.js"
    },
    "./ui": {
      "types": "./packages/web-sdk/src/ui.d.ts",
      "import": "./packages/web-sdk/src/ui.js"
    },
    "./media": {
      "types": "./packages/web-sdk/src/media-profile.d.ts",
      "import": "./packages/web-sdk/src/media-profile.js"
    }
  },
  "files": [
    "packages/protocol/src",
    "packages/web-mock/src",
    "packages/web-sdk/src"
  ],
  "repository": "https://github.com/Josp3r/open-jsbridge",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
