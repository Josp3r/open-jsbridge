{
  "name": "open-jsbridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"packages/**/*.ts\"",
    "spec:lint": "npm run build --silent && node scripts/codegen.mjs --lint",
    "codegen:ts": "npm run build --silent && node scripts/codegen.mjs --target ts --out packages/web-sdk/src/generated/spec.ts",
    "codegen:check": "npm run build --silent && node scripts/codegen.mjs --lint --target ts --out packages/web-sdk/src/generated/spec.ts --check",
    "size:web": "npm run build --silent && node scripts/check-web-size.mjs",
    "pack:web": "node scripts/pack-web.mjs",
    "build:sdk-consumer": "node scripts/build-sdk-consumer.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run build && node --test conformance-tests/*.test.mjs",
    "demo:web": "npm run build && node examples/web-demo/serve.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
