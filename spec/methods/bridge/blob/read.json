{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ojsb:method/bridge.blob.read",
  "title": "bridge.blob.read",
  "description": "按从零开始的索引读取当前文档会话内只读资源。每个非末片含 64 KiB，末片含 1 至 64 KiB 原始字节。读已释放的引用返回 -32003。",
  "x-ojsb-kind": "method",
  "x-ojsb-version": 1,
  "x-ojsb-since": "1.0",
  "params": {
    "type": "object",
    "properties": {
      "blobRef": { "$ref": "ojsb:schema/blob.ref" },
      "index": { "type": "integer", "minimum": 0, "maximum": 319 }
    },
    "required": ["blobRef", "index"],
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "properties": {
      "dataBase64": {
        "type": "string",
        "contentEncoding": "base64",
        "minLength": 4,
        "maxLength": 87384,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])",
        "if": { "minLength": 87384 },
        "then": { "pattern": "==$" }
      },
      "done": { "type": "boolean" }
    },
    "required": ["dataBase64", "done"],
    "additionalProperties": false,
    "if": {
      "properties": { "done": { "const": false } },
      "required": ["done"]
    },
    "then": {
      "properties": { "dataBase64": { "type": "string", "minLength": 87384 } }
    }
  }
}
