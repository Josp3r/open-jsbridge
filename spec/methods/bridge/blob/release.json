  "params": {
    "type": "object",
    "properties": {
      "blobRef": { "$ref": "ojsb:schema/blob.ref" }
    },
    "required": ["blobRef"],
    "additionalProperties": false
  },
  "result": { "type": "object", "maxProperties": 0 }
}
